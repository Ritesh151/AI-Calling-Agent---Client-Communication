# ============================================
# AI Call Reception System - Environment Variables
# ============================================
# Copy this file to .env and adjust values

# --- Project ---
PROJECT_NAME=AI Call Reception System
ENVIRONMENT=development
DEBUG=true

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- PostgreSQL ---
# Use "localhost" for local dev, "postgres" when using Docker Compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=callreception
POSTGRES_PASSWORD=callreception_secret
POSTGRES_DB=callreception
# Set DATABASE_URL to override assembled URL (Docker: postgresql+psycopg2://callreception:callreception_secret@postgres:5432/callreception)
# DATABASE_URL=postgresql+psycopg2://callreception:callreception_secret@localhost:5432/callreception

# --- Redis ---
# Use "localhost" for local dev, "redis" when using Docker Compose
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set REDIS_URL to override assembled URL (Docker: redis://redis:6379/0)
# REDIS_URL=redis://localhost:6379/0

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=ai_call_reception
MONGODB_ENABLED=true

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security ---
BCRYPT_ROUNDS=12
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# --- Sentry ---
SENTRY_DSN=

# --- Device Management ---
ADB_HOST=127.0.0.1
ADB_PORT=5037
DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
DEVICE_TIMEOUT_SECONDS=10

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
