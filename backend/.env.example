ENVIRONMENT=development
DEBUG=true

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=callreception
POSTGRES_PASSWORD=callreception_secret
POSTGRES_DB=callreception

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=ai_call_reception
MONGODB_ENABLED=true

JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

BCRYPT_ROUNDS=12

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=300

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true

ADB_HOST=127.0.0.1
ADB_PORT=5037
DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
DEVICE_TIMEOUT_SECONDS=10
